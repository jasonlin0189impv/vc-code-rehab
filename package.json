{
  "name": "vc-code-rehab",
  "displayName": "Code Rehab",
  "description": "Track your manual coding tokens and get nagged into using AI. Your daily intervention for hand-written boilerplate.",
  "version": "0.1.0",
  "publisher": "jasonlin0189impv",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonlin0189impv/vc-code-rehab"
  },
  "homepage": "https://github.com/jasonlin0189impv/vc-code-rehab#readme",
  "sponsor": {
    "url": "https://github.com/sponsors/jasonlin0189impv"
  },
  "keywords": ["ai", "coding", "productivity", "token", "limitation"],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vcCodeRehab.showStats",
        "title": "VC Code Rehab: Show Token Stats"
      },
      {
        "command": "vcCodeRehab.resetToday",
        "title": "VC Code Rehab: Reset Today's Count"
      },
      {
        "command": "vcCodeRehab.pauseTracking",
        "title": "VC Code Rehab: Pause Tracking (1 hour)"
      },
      {
        "command": "vcCodeRehab.resumeTracking",
        "title": "VC Code Rehab: Resume Tracking"
      }
    ],
    "configuration": {
      "title": "VC Code Rehab",
      "properties": {
        "vcCodeRehab.dailyTokenLimit": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "description": "Maximum manually typed tokens allowed per day before notifications begin."
        },
        "vcCodeRehab.tokensPerExtraNotification": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "How many additional manual tokens must be typed before showing the next warning after the daily limit is reached."
        },
        "vcCodeRehab.manualTypingMaxChunkSize": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "Insertions larger than this character count are treated as AI/paste, not manual typing."
        },
        "vcCodeRehab.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the token count in the status bar."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.20.0"
  }
}
